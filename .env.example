# Environment configuration for API Sentinel
NODE_ENV=development
PORT=4000

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/api_sentinel

# Redis Connection (localhost or Upstash / Cloud Redis URI)
REDIS_URL=redis://localhost:6379

# Frontend Client Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Authentication & Session Secrets (min 16 chars)
SESSION_SECRET=replace_with_a_secure_random_secret_at_least_16_characters
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_16_characters
JWT_EXPIRES_IN=7d

# Monitoring Defaults & Bounds
MONITOR_DEFAULT_INTERVAL_SECONDS=60
MONITOR_MIN_INTERVAL_SECONDS=10
MONITOR_MAX_INTERVAL_SECONDS=86400
MONITOR_DEFAULT_TIMEOUT_MS=5000
MONITOR_MAX_TIMEOUT_MS=30000

# Local Mock API Service for Deterministic Testing
MOCK_API_URL=http://localhost:8080

# Background Worker Settings
CHECK_WORKER_CONCURRENCY=5
CHECK_MAX_RETRIES=2

# Structured Logging Level (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info
